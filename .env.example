PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional non-SRV connection string used when SRV DNS lookup is unavailable.
MONGODB_DIRECT_URI=mongodb://<username>:<password>@<host-1>:27017,<host-2>:27017,<host-3>:27017/<database>?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
